{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions for Yeonsik's Note",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-batch",
    "notification:allow-get-pending",
    "notification:allow-cancel",
    "allow-deadline-exact-alarm-status",
    "allow-deadline-open-exact-alarm-settings",
    "allow-load-runtime-config",
    "allow-load-persisted-device",
    "allow-save-persisted-device",
    "allow-quick-capture-shortcut-status",
    "allow-show-quick-capture",
    "allow-open-db-editor-window",
    "allow-open-project-workspace-window",
    "allow-knowledge-vault-get-config",
    "allow-knowledge-vault-set-path",
    "allow-knowledge-vault-create-document",
    "allow-knowledge-vault-write-generated-file",
    "allow-knowledge-vault-update-document",
    "allow-knowledge-vault-move-file",
    "allow-knowledge-vault-open-file",
    "allow-github-config-status",
    "allow-github-save-config",
    "allow-github-delete-config",
    "allow-github-connection-status",
    "allow-github-device-flow-start",
    "allow-github-device-flow-poll",
    "allow-github-device-flow-cancel",
    "allow-github-disconnect",
    "allow-github-list-repositories",
    "allow-github-list-branches",
    "allow-github-read-repository"
  ]
}
